      "n": 2
    },
    {
      "task_type": "person_count",
      "operator": "gte",
      "n": 3
    },
    {
      "task_type": "person_count",
      "operator": "gte",
      "n": 4
    },
    {
      "task_type": "person_count",
      "operator": "gte",
      "n": 5
