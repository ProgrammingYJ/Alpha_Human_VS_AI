  "engineering_near_target_band": null,
  "target_tolerance_note": "User requested approximately 40%; a numerical pass band is not yet fixed. Report measured distance to 0.40, never claim an exact guarantee.",
  "selection": {
    "split": "val",
    "seed": 20261022,
